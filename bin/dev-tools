#!/usr/bin/env python3
"""Developer environment commands; browser dependencies are installed separately."""

import os
import sys
from pathlib import Path

repo = Path(__file__).resolve().parent.parent
if len(sys.argv) > 1 and sys.argv[1] == "repair-env":
    import shutil
    ansible = shutil.which("ansible-playbook")
    if not ansible:
        sys.exit("Install Ansible on this controller first.")
    os.environ["ANSIBLE_CONFIG"] = str(repo / "ansible/ansible.cfg")
    os.execv(sys.executable, [sys.executable,
        str(repo / "skills/proton-pass/scripts/access.py"), "authenticated-exec",
        "--reason", "Restore development host environment credentials from the configured Proton vault references.",
        "--", "run", "--env-file", str(repo / "config/secrets.map"), "--",
        ansible, "-i", str(repo / "ansible/inventory.yml"),
        str(repo / "ansible/repair-env.yml"), *sys.argv[2:]])
elif len(sys.argv) > 1 and sys.argv[1] == "apply":
    os.execv(sys.executable, [sys.executable, str(repo / "fleet/deploy.py"), *sys.argv[2:]])
elif len(sys.argv) > 1 and sys.argv[1] == "keymap":
    os.execv("/bin/sh", ["sh", str(repo / "config/apply-keymaps.sh"), *sys.argv[2:]])
elif len(sys.argv) > 1 and sys.argv[1] == "native-browser":
    sys.path.insert(0, str(repo / "native_browser"))
    if len(sys.argv) > 2 and sys.argv[2] == "install-mac":
        from mac import main
        main(sys.argv[2:])
    elif sys.argv[2:3] in (["check"], ["mcp"]):
        from router import main
        sys.argv = [sys.argv[0], *(["--check"] if sys.argv[2:3] == ["check"] else []), *sys.argv[3:]]
        main()
    else:
        sys.exit("Usage: dev-tools native-browser {check|mcp|install-mac} [options]")
elif len(sys.argv) > 1 and sys.argv[1] == "shared-browser":
    import shutil
    if sys.argv[2:3] == ["install"]:
        os.execv("/bin/sh", ["sh", str(repo / "shared_browser/install.sh")])
    installed = Path.home() / ".local/bin/dev-tools-shared-browser"
    if installed.is_file():
        os.execv(str(installed), [str(installed), *sys.argv[2:]])
    node = shutil.which("node")
    if not node:
        sys.exit("Node.js is required for shared-browser")
    entry = "mcp.mjs" if sys.argv[2:3] == ["mcp"] else "cli.mjs"
    os.execv(node, [node, str(repo / "shared_browser" / entry), *sys.argv[2:]])
elif len(sys.argv) > 1 and sys.argv[1] == "browser":
    sys.path.insert(0, str(repo / "browser"))
    from manager import main

    main(sys.argv[2:])
else:
    os.execv(str(repo / "provision.sh"), [str(repo / "provision.sh"), *sys.argv[1:]])
